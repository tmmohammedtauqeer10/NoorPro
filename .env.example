# GOOGLE_WEB_CLIENT_ID: Required for Firebase Google Sign In.
GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
# Restrict this key to the YouTube Data API v3 and your Android app.
YOUTUBE_API_KEY=YOUR_YOUTUBE_DATA_API_KEY
# AdMob banner unit ids for RELEASE BuildConfig (paste real values before Play).
# Debug source set may keep Google sample units (ca-app-pub-394025609…).
# Release must NEVER use sample units — leave blank until real ids are ready.
ADMOB_FEED_BANNER=
ADMOB_BOTTOM_BANNER=

# Google Maps SDK for Android key (restrict to com.noorpro.app and the signing SHA-1).
MAPS_API_KEY=YOUR_ANDROID_MAPS_API_KEY
