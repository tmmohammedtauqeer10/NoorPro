<?xml version="1.0" encoding="utf-8"?>
<!-- 1.0.98 widget. previewLayout = live scalable picker preview (Android 12+);
     previewImage = rendered fallback for Android 11 and older pickers. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_continue_quran_2x2"
    android:previewLayout="@layout/widget_preview_quran"
    android:previewImage="@drawable/widget_picker_continue_quran"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_continue_quran_description" />
