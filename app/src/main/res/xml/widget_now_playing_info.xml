<?xml version="1.0" encoding="utf-8"?>
<!-- 1.0.98 widget. previewLayout = live scalable picker preview (Android 12+);
     previewImage = rendered fallback for Android 11 and older pickers. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="250dp"
    android:minResizeHeight="80dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_now_playing_4x2"
    android:previewLayout="@layout/widget_preview_now_playing"
    android:previewImage="@drawable/widget_picker_now_playing"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_now_playing_description" />
