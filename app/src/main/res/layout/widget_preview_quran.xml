<?xml version="1.0" encoding="utf-8"?>
<!-- 1.0.98 Continue Quran 2x2 (mint, dark-aware): book icon, last-read surah + ayah, Continue pill. Picker preview. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_mint"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="14dp"
    android:paddingEnd="14dp"
    android:paddingBottom="14dp">

    <ImageView
        android:id="@+id/widget_cq_book"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_widget_book" />

    <FrameLayout android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
        <TextView
            android:id="@+id/widget_cq_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:text="Continue Quran"
            android:textColor="@color/widget_ink_muted"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/widget_cq_surah"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:text="Al-Baqarah"
            android:textColor="@color/widget_ink"
            android:textSize="21sp"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_cq_ayah"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:text="Ayah 25"
            android:textColor="@color/widget_ink_muted"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />

    <FrameLayout android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />

    <TextView
        android:id="@+id/widget_cq_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_pill_button"
        android:gravity="center"
        android:maxLines="1"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="Continue →"
        android:textColor="@color/widget_pill_button_text"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
