<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_next_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_bg"
    android:orientation="vertical"
    android:padding="12dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/widget_next_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_next_prayer_label"
        android:textColor="@color/widget_muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_next_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Maghrib"
        android:textColor="@color/widget_accent"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_next_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="18:42"
        android:textColor="@color/widget_text"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/widget_next_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="in 42m"
        android:textColor="@color/widget_muted"
        android:textSize="13sp" />
</LinearLayout>
