<?xml version="1.0" encoding="utf-8"?>
<!-- 1.0.98 Prayer times 4x2 (light card, dark-aware): header, next prayer + time, countdown, five-column day row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_card"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:id="@+id/widget_day_header_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="NoorPro"
            android:src="@drawable/brand_n_tile" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:text="Prayer times"
            android:textColor="@color/widget_ink"
            android:textSize="15sp"
            android:layout_marginStart="10dp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold" />
        <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <TextView
            android:id="@+id/widget_day_today"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:text="Today"
            android:textColor="@color/widget_ink_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <FrameLayout android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" android:minHeight="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_day_next_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:text=""
            android:textColor="@color/widget_ink"
            android:textSize="28sp"
            android:fontFamily="sans-serif"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_day_next_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:text="--:--"
            android:textColor="@color/widget_accent_text"
            android:textSize="28sp"
            android:layout_marginStart="10dp"
            android:fontFamily="sans-serif"
            android:textStyle="bold" />
    </LinearLayout>
        <TextView
            android:id="@+id/widget_day_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:text="Prayer times"
            android:textColor="@color/widget_ink_muted"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />

    <ImageView
        android:id="@+id/widget_day_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="6dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/widget_day_fajr_slot"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">
            <TextView
                android:id="@+id/widget_day_fajr_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:text="Fajr"
                android:textColor="@color/widget_ink"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium" />
            <TextView
                android:id="@+id/widget_day_fajr_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:text="--:--"
                android:textColor="@color/widget_ink"
                android:textSize="16sp"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />
        </LinearLayout>
        <ImageView
            android:layout_width="1dp"
            android:layout_height="26dp"
            android:layout_gravity="center_vertical"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_divider" />
        <LinearLayout
            android:id="@+id/widget_day_dhuhr_slot"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">
            <TextView
                android:id="@+id/widget_day_dhuhr_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:text="Dhuhr"
                android:textColor="@color/widget_ink"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium" />
            <TextView
                android:id="@+id/widget_day_dhuhr_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:text="--:--"
                android:textColor="@color/widget_ink"
                android:textSize="16sp"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />
        </LinearLayout>
        <ImageView
            android:layout_width="1dp"
            android:layout_height="26dp"
            android:layout_gravity="center_vertical"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_divider" />
        <LinearLayout
            android:id="@+id/widget_day_asr_slot"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">
            <TextView
                android:id="@+id/widget_day_asr_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:text="Asr"
                android:textColor="@color/widget_ink"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium" />
            <TextView
                android:id="@+id/widget_day_asr_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:text="--:--"
                android:textColor="@color/widget_ink"
                android:textSize="16sp"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />
        </LinearLayout>
        <ImageView
            android:layout_width="1dp"
            android:layout_height="26dp"
            android:layout_gravity="center_vertical"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_divider" />
        <LinearLayout
            android:id="@+id/widget_day_maghrib_slot"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">
            <TextView
                android:id="@+id/widget_day_maghrib_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:text="Maghrib"
                android:textColor="@color/widget_ink"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium" />
            <TextView
                android:id="@+id/widget_day_maghrib_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:text="--:--"
                android:textColor="@color/widget_ink"
                android:textSize="16sp"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />
        </LinearLayout>
        <ImageView
            android:layout_width="1dp"
            android:layout_height="26dp"
            android:layout_gravity="center_vertical"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_divider" />
        <LinearLayout
            android:id="@+id/widget_day_isha_slot"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">
            <TextView
                android:id="@+id/widget_day_isha_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:text="Isha"
                android:textColor="@color/widget_ink"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium" />
            <TextView
                android:id="@+id/widget_day_isha_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:text="--:--"
                android:textColor="@color/widget_ink"
                android:textSize="16sp"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
