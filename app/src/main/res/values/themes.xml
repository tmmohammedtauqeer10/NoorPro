<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Production theme name (was Theme.MyApplication after AI Studio template). -->
    <style name="Theme.NoorPro" parent="android:Theme.DeviceDefault.NoActionBar" />
    <!-- Temporary alias so any stale references keep compiling during rename. -->
    <style name="Theme.MyApplication" parent="Theme.NoorPro" />
    <!-- Launch theme: Android 12+ SplashScreen API (androidx core-splashscreen back-port).
         1.0.97: flat logo green + cream N (values-v31 adds the NoorPro wordmark branding). -->
    <style name="Theme.NoorPro.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0B6243</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_mark</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.NoorPro</item>
    </style>
</resources>
