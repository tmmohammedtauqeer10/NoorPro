<?xml version="1.0" encoding="utf-8"?>
<!-- 1.0.98: Now playing progress bar (cream on translucent cream). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle"><corners android:radius="2dp" /><solid android:color="@color/widget_progress_track" /></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip><shape android:shape="rectangle"><corners android:radius="2dp" /><solid android:color="@color/widget_on_green" /></shape></clip>
    </item>
</layer-list>
