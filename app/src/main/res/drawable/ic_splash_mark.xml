<?xml version="1.0" encoding="utf-8"?>
<!-- Splash mark: the launcher crescent on a cream disc with a gold ring (icon sits inside the 2/3 safe zone). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="18dp" android:top="18dp" android:right="18dp" android:bottom="18dp">
        <shape android:shape="oval">
            <solid android:color="#FAF3EA" />
            <stroke android:width="3dp" android:color="#D4AF37" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_launcher_foreground" android:left="14dp" android:top="14dp" android:right="14dp" android:bottom="14dp" />
</layer-list>
